# Local MongoDB (run mongod locally, or use Docker: docker run -d -p 27017:27017 mongo)
MONGODB_URI=mongodb://localhost:27017/neusomahealing

# Or use MongoDB Atlas (free tier) — get this string from atlas.mongodb.com:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/neusomahealing

PORT=4000

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:3000
